{
  "name": "wind-turbine-maintenance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "build:electron": "tsc -b && vite build --mode electron && electron-builder",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "check": "tsc -b && oxlint && vitest run && vite build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@tmcw/togeojson": "^7.1.2",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "exifr": "7.1.3",
    "fflate": "^0.8.3",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "onnxruntime-web": "1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.wtm.app",
    "productName": "WTM Wind Turbine Maintenance",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "allowScripts": {
    "core-js@3.29.1": true,
    "electron-winstaller@5.4.0": true
  }
}
